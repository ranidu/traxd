model Visit {
    id String @id @default(uuid())
    place Place @relation(fields: [placeId], references: [id])
    placeId String
    remarks String?
    location String?
    latitude  Float
    longitude Float
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    deletedAt DateTime?
    visitItems VisitItem[]
    user User @relation(fields: [userId], references: [id])
    userId String
}